# App
APP_NAME="PocketSafar API"
APP_VERSION="2.0.0"
DEBUG=True

# MongoDB (Atlas M0 Tier connection string)
MONGODB_URI="MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pocketsafar?retryWrites=true&w=majority&appName=Cluster0""
MONGODB_DB_NAME="pocketsafar"

# JWT Auth
JWT_SECRET_KEY="your-super-secret-jwt-key-change-me"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (For later)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (For photos)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_STORAGE_BUCKET="photos"

# Gemini AI (For Phase 3)
GEMINI_API_KEY=""

# CORS
CORS_ORIGINS="http://localhost:3000"
